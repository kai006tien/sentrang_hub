# ═══════════════════════════════════════════════════════════════════
# SEN TRẮNG HUB — Environment Variables
# ═══════════════════════════════════════════════════════════════════
# Copy file này thành .env và điền thông tin thực tế:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# ─── SUPABASE ─────────────────────────────────────────────────────
# Lấy từ: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# ─── CLOUDFLARE R2 ────────────────────────────────────────────────
# Lấy từ: https://dash.cloudflare.com → R2 → Overview → Manage R2 API Tokens
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET=sentranghub-media
CLOUDFLARE_R2_PUBLIC_URL=https://media.sentranghub.vn

# ─── APP ──────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-random-secret-key

# ─── SUPER ADMIN (chỉ dùng khi seed) ─────────────────────────────
SUPER_ADMIN_EMAIL=admin@sentranghub.vn
SUPER_ADMIN_PASSWORD=SenTrang@2026!
